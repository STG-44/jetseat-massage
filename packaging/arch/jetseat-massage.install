post_install() {
  if command -v udevadm >/dev/null; then
    udevadm control --reload-rules || true
  fi
  printf '%s\n' 'JetSeat Massage: reconnect the seat USB for access without root.'
}

post_upgrade() {
  post_install
}

post_remove() {
  if command -v udevadm >/dev/null; then
    udevadm control --reload-rules || true
  fi
}
